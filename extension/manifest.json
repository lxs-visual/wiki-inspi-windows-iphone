{
  "manifest_version": 3,
  "name": "Envoyer à Inspi",
  "version": "3.0.0",
  "description": "Clic droit sur une image, une vidéo (même sur Instagram), un texte, un lien ou une page pour l'envoyer à Inspi Local.",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Inspi : options"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}